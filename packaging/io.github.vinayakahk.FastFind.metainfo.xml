  </description>
  <launchable type="desktop-id">fastfind.desktop</launchable>
  <provides>
    <binary>fastfind-gui</binary>
    <binary>fastfind</binary>
  </provides>
  <categories>
    <category>Utility</category>
    <category>FileTools</category>
  </categories>
  <developer_name>VinayakaHK</developer_name>
  <url type="homepage">https://github.com/VinayakaHk/fastfind</url>
</component>
